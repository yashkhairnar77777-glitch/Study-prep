{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and student preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "primarySubject": { "type": "string" }
      },
      "required": ["userId", "email", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Personal student profile and study data"
    }
  }
}
