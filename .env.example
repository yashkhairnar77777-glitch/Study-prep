# ORYQEN STUDY AI — Environment Configuration Example
# Never commit real secrets or API keys.

# --- PRIMARY AI PROVIDER (Groq) ---
# Sign up at https://console.groq.com to get your API key
GROQ_API_KEY=""
# Recommended text models: "llama-3.3-70b-versatile", "llama-3.1-8b-instant"
GROQ_MODEL="llama-3.3-70b-versatile"
# Recommended vision model: "llama-3.2-11b-vision-preview"
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

# --- SECONDARY AI PROVIDER (OpenRouter) ---
# Sign up at https://openrouter.ai to get your API key
OPENROUTER_API_KEY=""
# Recommended OpenRouter models: "meta-llama/llama-3.3-70b-instruct:free", "google/gemini-2.5-flash"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# --- BUILT-IN / FALLBACK AI PROVIDER (Google Gemini) ---
# AI Studio injects this automatically at runtime from user secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# --- SUPABASE AUTHENTICATION (Optional Genuine Cloud Auth) ---
# Sign up at https://supabase.com to create a free project
# If not set, the app runs in secure local student session mode with clear guidance
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- GOOGLE AUTHENTICATION (Real Google Account Sign-In) ---
# Create a Web OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Add your app URL to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=""

# --- SERVER & DEPLOYMENT CONFIGURATION ---
PORT="3000"
APP_URL="MY_APP_URL"
